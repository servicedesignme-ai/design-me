+// Titre de page légale : le dernier mot est affiché en dégradé, comme sur le reste du site.
+export default function LegalTitle({ title }: { title: string }) {
+  const words = title.trim().split(/\s+/)
+  const last = words.pop()
+  return (
+    <h1>
+      {words.length > 0 && `${words.join(' ')} `}
+      <span>{last}</span>
+    </h1>
+  )
+}
diff --git a/src/app/components/legal-page/getLegalPage.ts b/src/app/components/legal-page/getLegalPage.ts
