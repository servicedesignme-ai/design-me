+++ b/src/app/components/legal-page/getLegalPage.ts
@@ -0,0 +1,32 @@
+import { getPayload } from 'payload'
+import config from '@payload-config'
+import { unstable_cache } from 'next/cache'
+
+export type LegalSlug = 'mentions-legales' | 'politique-de-confidentialite'
+
+const fetchLegalPage = unstable_cache(
+  async (slug: LegalSlug) => {
+    const payload = await getPayload({ config })
+    const result = await payload.find({
+      collection: 'legal',
+      where: { slug: { equals: slug } },
+      limit: 1,
+    })
+    return result.docs[0] ?? null
+  },
+  ['legal'],
+  {
+    revalidate: 3600,
+    tags: ['legal'],
+  },
+)
+
+// Renvoie la page saisie dans Payload, ou null (le texte par défaut du code est alors affiché).
+export async function getLegalPage(slug: LegalSlug) {
+  try {
+    return await fetchLegalPage(slug)
+  } catch (error) {
+    console.error(`[legal] Impossible de charger "${slug}" depuis Payload`, error)
+    return null
+  }
+}
